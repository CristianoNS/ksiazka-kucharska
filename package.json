{
  "name": "ksiazka-kucharska",
  "version": "1.1.0",
  "description": "Aplikacja desktopowa do przechowywania przepisów kulinarnych",
  "main": "main.js",
  "author": "Ty",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "docx": "^8.5.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.domowe.ksiazkakucharska",
    "productName": "Książka Kucharska",
    "directories": {
      "output": "dist"
    },
    "files": [
      "common.js",
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "artifactName": "Książka Kucharska.exe"
    }
  }
}
